# Provider generativo
NAVI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=1024

# RAG / LlamaIndex
NAVI_DOCUMENTS_DIR=data/documents
NAVI_INDEX_DIR=data/index
NAVI_EMBEDDING_MODEL=gemini-embedding-2
# batchEmbedContents consome uma unidade da cota para cada texto do lote.
NAVI_EMBEDDING_BATCH_SIZE=20
NAVI_EMBEDDING_TEXTS_PER_MINUTE=100
NAVI_EMBEDDING_MAX_ATTEMPTS=5
NAVI_EMBEDDING_RETRY_BASE_SECONDS=2
NAVI_EMBEDDING_RETRY_MAX_SECONDS=120
NAVI_RAG_TOP_K=5
NAVI_RAG_MIN_SCORE=0.20
NAVI_CHUNK_SIZE=900
NAVI_CHUNK_OVERLAP=150

# Canais e atendimento
TELEGRAM_BOT_TOKEN=
NAVI_HUMAN_CONTACT=Procure a equipe do NAF para atendimento individualizado.
NAVI_MAX_HISTORY_MESSAGES=8
NAVI_MAX_QUESTION_CHARS=3000
NAVI_API_HOST=0.0.0.0
NAVI_API_PORT=8000
NAVI_LOG_LEVEL=INFO

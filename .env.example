# Provider generativo
NAVI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=1024

# RAG / LlamaIndex
NAVI_DOCUMENTS_DIR=data/documents
NAVI_INDEX_DIR=data/index
NAVI_EMBEDDING_MODEL=gemini-embedding-2
# batchEmbedContents consome uma unidade da cota para cada texto do lote.
NAVI_EMBEDDING_BATCH_SIZE=20
NAVI_EMBEDDING_TEXTS_PER_MINUTE=100
NAVI_EMBEDDING_MAX_ATTEMPTS=5
NAVI_EMBEDDING_RETRY_BASE_SECONDS=2
NAVI_EMBEDDING_RETRY_MAX_SECONDS=120
NAVI_RAG_TOP_K=5
NAVI_RAG_MIN_SCORE=0.20
NAVI_CHUNK_SIZE=900
NAVI_CHUNK_OVERLAP=150

# Canais e atendimento
TELEGRAM_BOT_TOKEN=
NAVI_HUMAN_CONTACT=Procure a equipe do NAF para atendimento individualizado.
NAVI_MAX_HISTORY_MESSAGES=8
NAVI_MAX_QUESTION_CHARS=3000
NAVI_API_HOST=0.0.0.0
NAVI_API_PORT=8000
NAVI_LOG_LEVEL=INFO

# Aplicativo e armazenamento portátil/local
# Use "local" para LLM e embeddings locais; "auto" acompanha NAVI_PROVIDER.
NAVI_EMBEDDING_PROVIDER=auto
NAVI_DATA_ROOT=runtime
# Caminhos relativos são resolvidos dentro de NAVI_DATA_ROOT.
# NAVI_LOCAL_MODEL_PATH=models/seu-modelo.gguf
# NAVI_LOCAL_DOCUMENTS_DIR=documents
# NAVI_LOCAL_INDEX_DIR=index
# NAVI_LOCAL_EMBEDDING_CACHE_DIR=embeddings
# NAVI_LOCAL_CONFIG_DIR=config
NAVI_LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
NAVI_LOCAL_EMBEDDING_BATCH_SIZE=32
# NAVI_LOCAL_EMBEDDING_THREADS=4
# true impede downloads durante a execução e garante falha fechada no modo offline.
NAVI_LOCAL_EMBEDDING_LOCAL_FILES_ONLY=true
NAVI_LOCAL_CONTEXT_SIZE=4096
NAVI_LOCAL_MAX_OUTPUT_TOKENS=512
# NAVI_LOCAL_THREADS=4
# NAVI_LOCAL_CHAT_FORMAT=
